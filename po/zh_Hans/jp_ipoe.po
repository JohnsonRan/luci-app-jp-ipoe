msgid "offset"
msgstr "偏移"

msgid "Port Forwarding"
msgstr "端口转发"

msgid "IPv4 external ports must be assigned; LAN service ports need not be. Checks cover redirects, router bindings and outbound NAT, not custom nftables rules. Stop UPnP first."
msgstr "IPv4 外部端口须在分配范围内，内网端口不限于此。检查涵盖转发规则、路由器端口及出站 NAT，不含自定义 nftables 规则。使用前停止 UPnP。"

msgid "IPv4 targets use the main lan subnet. Ports are reserved from SNAT without changing manual reservations. Public IPv4 or incompatible allocation changes suspend rules; delete and recreate them."
msgstr "IPv4 目标须在主 lan 子网。转发端口不用于出站 NAT，手动预留不变。公网 IPv4 变更或端口分配不兼容会暂停规则，请删除后重建。"

msgid "Protocol"
msgstr "协议"

msgid "LAN IPv4 Address"
msgstr "内网 IPv4 地址"

msgid "External Port"
msgstr "外部端口"

msgid "Check & Add Forward"
msgstr "检查并添加转发"

msgid "Public Endpoint"
msgstr "公网地址与端口"

msgid "LAN Endpoint"
msgstr "内网地址与端口"

msgid "Published to tunnel"
msgstr "已发布到隧道"

msgid "Inactive (tunnel down, allocation changed or local check failed)"
msgstr "未生效（隧道未连接、分配变化或本地检查失败）"

msgid "Delete"
msgstr "删除"

msgid "No managed port forwards."
msgstr "尚未创建端口转发。"

msgid "Apply Port Forwarding"
msgstr "应用端口转发"

msgid "Updates do not restart MAP-E or clear existing connections."
msgstr "更新规则不重启 MAP-E，也不清除已有连接。"

msgid "This exposes the LAN service to the Internet. Secure it first; local checks do not guarantee future availability."
msgstr "这会向公网开放内网服务，请先确保安全。本地检查不保证今后始终可用。"

msgid "Port forward removed."
msgstr "端口转发已删除。"

msgid "Port forward added:"
msgstr "端口转发已添加："

msgid "Confirm"
msgstr "确认"

msgid "Stop MAP-E now? IPv4 traffic using IPoE will be interrupted."
msgstr "现在停止 MAP-E？通过 IPoE 传输的 IPv4 流量将中断。"

msgid "Refresh failed; displayed rules may be outdated."
msgstr "刷新失败，所示规则可能已过期。"

msgid "A port-forwarding operation is in progress. Please wait."
msgstr "端口转发操作正在进行，请稍候。"

msgid "Automatic port"
msgstr "自动选择端口"

msgid "IPoE is already configured. No restart needed."
msgstr "配置已生效，无需重启。"

msgid "Force reconnect and repair IPoE? This runs the full setup and may interrupt IPv4 and IPv6 traffic."
msgstr "强制重连并修复 IPoE？这将执行完整配置流程，可能中断 IPv4 和 IPv6 流量。"

msgid "Force Reconnect / Repair"
msgstr "强制重连 / 修复"

msgid "Force full setup when IPoE is connected but unusable."
msgstr "已连接但无法使用时，强制重新配置。"

msgid "Public IPv4"
msgstr "公网 IPv4"

msgid "Loading..."
msgstr "正在加载…"

msgid "Add a forward"
msgstr "新增转发"

msgid "Existing forwards"
msgstr "已有转发"

msgid "Published rules are not proof of Internet reachability."
msgstr "规则已发布不代表公网已连通。"

msgid "Checks and limitations"
msgstr "检查范围与使用限制"

msgid "MAP-E connected"
msgstr "MAP-E 已连接"

msgid "Assigned ports"
msgstr "已分配端口"

msgid "Port ranges"
msgstr "端口段"

msgid "Native IPv6 rules are not removed by stopping MAP-E."
msgstr "停止 MAP-E 不会撤销原生 IPv6 放行规则。"

msgid "Leave the IPv4 external port empty for automatic selection. IPv6 uses the device address and service port directly."
msgstr "IPv4 外部端口留空即自动选择。IPv6 直接使用设备的公网地址和服务端口。"

msgid "Device (MAC)"
msgstr "设备（MAC）"

msgid "Enter addresses manually"
msgstr "手动输入地址"

msgid "IP version"
msgstr "IP 版本"

msgid "Fills current addresses only, without MAC binding. Verify the address and LAN service."
msgstr "仅填入当前地址，不绑定 MAC；请核对地址和内网服务。"

msgid "Device public IPv6"
msgstr "设备公网 IPv6"

msgid "Service Port"
msgstr "服务端口"

msgid "IPv6 rules survive MAP-E stop and plugin uninstall. Delete here or in Firewall traffic rules; recreate after destination IPv6 changes."
msgstr "停止 MAP-E 或卸载插件不会删除 IPv6 规则；请在此处或防火墙通信规则中删除。目标 IPv6 变化后须重建。"

msgid "Local checks: LAN routes, IPv4 port/NAT conflicts and duplicate managed IPv6 rules. Service availability and other firewall policies are not verified."
msgstr "仅检查 LAN 路由、IPv4 端口/NAT 冲突和 IPv6 管理规则重复；不验证服务可达性或其他防火墙策略。"

msgid "Unable to load devices. Enter addresses manually."
msgstr "无法加载设备列表，请手动输入地址。"

msgid "MAP-E is down. IPv4 forwarding requires IPoE; IPv6 uses the native connection."
msgstr "MAP-E 未连接。IPv4 转发需要启动 IPoE，IPv6 放行使用原生连接。"

msgid "Removal pending; retry deletion"
msgstr "删除未完成，请重试"

msgid "Firewall rule installed"
msgstr "已安装防火墙规则"

msgid "Firewall state unavailable"
msgstr "无法确认防火墙运行状态"

msgid "Deletion removes only this rule. Existing sessions or other firewall rules may still allow access."
msgstr "删除仅撤销本条规则。已有连接或其他防火墙规则可能仍允许访问。"

msgid "Dual stack saves two rules separately. On failure, successful rules remain; check existing rules before retrying."
msgstr "双栈分别保存两条规则；失败时已成功的规则会保留，请检查后再重试。"

msgid "Partial completion is possible. Review existing rules before retrying."
msgstr "操作可能仅部分完成，请先检查已有规则再重试。"

msgid "Unavailable"
msgstr "无法读取"

msgid "Conntrack entries / limit"
msgstr "连接跟踪条目 / 上限"

msgid "Conntrack insert failures"
msgstr "连接跟踪插入失败"

msgid "Conntrack drops"
msgstr "连接跟踪丢弃"

msgid "Conntrack early evictions"
msgstr "连接跟踪提前回收"

msgid "Conntrack covers the whole router. Failure/eviction counters are cumulative, not MAP-E port usage or Internet loss. Unavailable is not zero."
msgstr "连接跟踪统计覆盖全路由器；失败/回收为累计值，不代表 MAP-E 端口用量或公网丢包。无法读取不等于零。"
