{
	"luci-app-jp-ipoe": {
		"description": "Grant access to JP IPoE (MAP-E) configuration",
		"read": {
			"file": {
				"/usr/libexec/jp-ipoe-readonly": [ "exec" ]
			},
			"uci": [ "jp_ipoe" ]
		},
		"write": {
			"file": {
				"/usr/sbin/jp-ipoe-setup": [ "exec" ]
			},
			"ubus": {
				"uci": [ "commit" ]
			},
			"uci": [ "jp_ipoe" ]
		}
	}
}
