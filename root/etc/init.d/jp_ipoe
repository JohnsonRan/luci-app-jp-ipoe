#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1
PROG=/usr/sbin/jp-ipoe-setup

start_service() {
	local action="${1:-start}"
	local enabled
	config_load jp_ipoe
	config_get_bool enabled config enabled 0
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" "$action"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

boot() {
	start boot
}

stop_service() {
	/usr/sbin/jp-ipoe-setup stop
}

# No config reload trigger: rpcd's uci commit (LuCI Apply) emits config.change,
# and a restart here would tear down MAP-E behind the explicit Apply run.
